---
title: "Booking Admin | Heroes and Heritage Tours"
permalink: "/admin-bookings.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{{ title }}</title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #F4EEE1; color: #211C15; margin: 0; padding: 32px 20px 80px; }
    .wrap { max-width: 920px; margin: 0 auto; }
    h1 { font-size: 22px; margin-bottom: 4px; }
    .sub { color: #56503F; font-size: 14px; margin-bottom: 24px; }
    #loginGate { text-align: center; padding: 80px 20px; }
    #loginGate button, .save-btn { background: #8A1C24; color: #F4EEE1; border: none; border-radius: 8px; padding: 10px 18px; font-weight: 600; cursor: pointer; font-size: 14px; }
    #loginGate button:hover, .save-btn:hover { background: #B32332; }
    table { width: 100%; border-collapse: collapse; background: #FBF8F1; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 4px rgba(20,16,13,0.06); }
    th, td { text-align: left; padding: 10px 12px; font-size: 13px; border-bottom: 1px solid rgba(33,28,21,0.1); vertical-align: top; }
    th { background: rgba(33,28,21,0.04); font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.04em; }
    .full { color: #8A1C24; font-weight: 700; }
    .guest-list { font-size: 12px; color: #56503F; margin-top: 4px; }
    .guest-list div { margin-bottom: 2px; }
    .adjust-row { display: flex; gap: 6px; align-items: center; margin-top: 6px; }
    .adjust-row input { width: 56px; padding: 4px 6px; border: 1px solid rgba(33,28,21,0.2); border-radius: 4px; }
    #status { font-size: 13px; margin-bottom: 16px; min-height: 18px; }
    #empty { color: #7A7360; padding: 40px 0; text-align: center; }
  </style>
</head>
<body>
  <div class="wrap">
    <div id="loginGate">
      <h1>Booking Admin</h1>
      <p class="sub">Log in with the same account you use for the content editor.</p>
      <button id="loginBtn">Log In</button>
    </div>

    <div id="dashboard" hidden>
      <h1>Booking Admin</h1>
      <p class="sub">Every confirmed, paid booking, grouped by date. Capacity is capped at 8 guests per tour per date. Use "Block extra spots" to manually reserve or close a date (e.g. for a private group), independent of paid bookings.</p>
      <p id="status"></p>
      <div id="tableWrap"></div>
    </div>
  </div>

  <script>
    const loginGate = document.getElementById("loginGate");
    const dashboard = document.getElementById("dashboard");
    const statusEl = document.getElementById("status");
    const tableWrap = document.getElementById("tableWrap");

    document.getElementById("loginBtn").addEventListener("click", () => netlifyIdentity.open());

    function formatDate(iso) {
      const d = new Date(iso + "T00:00:00");
      return d.toLocaleDateString("en-CA", { weekday: "short", year: "numeric", month: "short", day: "numeric" });
    }

    async function loadBookings() {
      const user = netlifyIdentity.currentUser();
      if (!user) return;
      statusEl.textContent = "Loading...";
      try {
        const token = await user.jwt();
        const res = await fetch("/.netlify/functions/get-bookings", {
          headers: { Authorization: "Bearer " + token },
        });
        if (!res.ok) throw new Error("Request failed: " + res.status);
        const data = await res.json();
        renderTable(data);
        statusEl.textContent = "";
      } catch (err) {
        statusEl.textContent = "Couldn't load bookings: " + err.message;
      }
    }

    function renderTable(data) {
      if (!data.entries.length) {
        tableWrap.innerHTML = '<p id="empty">No bookings or capacity blocks recorded yet.</p>';
        return;
      }
      const rows = data.entries.map((e) => {
        const guestList = e.bookings.length
          ? '<div class="guest-list">' + e.bookings.map((b) => `<div>${b.fullName || "—"} · ${b.email || "—"} · ${b.guests} guest${b.guests === 1 ? "" : "s"}</div>`).join("") + "</div>"
          : "";
        return `
          <tr>
            <td>${formatDate(e.date)}</td>
            <td>${e.tourSlug}</td>
            <td>${e.totalGuests}</td>
            <td>${e.manualBlock}</td>
            <td class="${e.remaining <= 0 ? "full" : ""}">${e.remaining <= 0 ? "Full" : e.remaining}</td>
            <td>
              ${guestList}
              <div class="adjust-row">
                <input type="number" min="0" max="8" value="${e.manualBlock}" data-tour="${e.tourSlug}" data-date="${e.date}">
                <button class="save-btn">Save</button>
              </div>
            </td>
          </tr>`;
      }).join("");

      tableWrap.innerHTML = `
        <table>
          <thead><tr><th>Date</th><th>Tour</th><th>Booked</th><th>Blocked</th><th>Remaining</th><th>Guests / Adjust</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>`;

      tableWrap.querySelectorAll(".save-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const input = btn.previousElementSibling;
          btn.disabled = true;
          try {
            const user = netlifyIdentity.currentUser();
            const token = await user.jwt();
            const res = await fetch("/.netlify/functions/set-capacity", {
              method: "POST",
              headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
              body: JSON.stringify({ tourSlug: input.dataset.tour, dateISO: input.dataset.date, manualBlock: input.value }),
            });
            if (!res.ok) throw new Error(await res.text());
            statusEl.textContent = "Saved.";
            loadBookings();
          } catch (err) {
            statusEl.textContent = "Couldn't save: " + err.message;
            btn.disabled = false;
          }
        });
      });
    }

    netlifyIdentity.on("init", (user) => {
      if (user) {
        loginGate.hidden = true;
        dashboard.hidden = false;
        loadBookings();
      }
    });
    netlifyIdentity.on("login", () => {
      loginGate.hidden = true;
      dashboard.hidden = false;
      loadBookings();
      netlifyIdentity.close();
    });
    netlifyIdentity.on("logout", () => {
      loginGate.hidden = false;
      dashboard.hidden = true;
    });
    netlifyIdentity.init();
  </script>
</body>
</html>
