---
layout: base.njk
title: "Heroes and Heritage Tours | Canadian WWI Battlefield Tours from Arras"
description: "Travel back in time and follow in the footsteps of heroes. Small-group, expert-guided tours of Vimy Ridge, Flanders Fields and the Somme, based in Arras, France."
activeNav: home
permalink: "/index.html"
---
{% from "partials/macros.njk" import tourCard, testimonialCard %}

<header class="hero">
  <div class="hero-media" id="heroCarousel">
    {% for slide in home.heroSlides %}
    <div class="hero-carousel-slide {% if loop.first %}is-active{% endif %}" data-carousel-slide>
      <img src="{{ slide.image }}" alt="{{ slide.alt }}" width="1800" height="1350" {% if not loop.first %}loading="lazy"{% endif %}>
    </div>
    {% endfor %}
    {% if home.heroSlides.length > 1 %}
    <div class="hero-carousel-dots" role="tablist" aria-label="Homepage image slideshow">
      {% for slide in home.heroSlides %}
      <button type="button" class="hero-carousel-dot {% if loop.first %}is-active{% endif %}" data-carousel-dot="{{ loop.index0 }}" aria-label="Show image {{ loop.index }} of {{ home.heroSlides.length }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}"></button>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <div class="container">
    <div class="hero-content">
      <span class="eyebrow">{{ home.heroEyebrow }}</span>
      <h1>{{ home.heroTitle }}</h1>
      <p class="lede">{{ home.heroLede }}</p>
      <div class="hero-actions">
        <a href="/tours.html" class="btn btn-primary btn-lg">Explore Our Tours</a>
        <a href="/contact.html" class="btn btn-ghost btn-lg" style="border-color: rgba(244,238,225,0.4); color: #FFF;">Plan a Private Tour</a>
      </div>
      <p class="hero-trust-line">{{ home.heroTrustLine }}</p>
    </div>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Where to begin</span>
      <h2>Choose Your Battlefield Journey</h2>
    </div>

    <div class="journey-grid" data-reveal>
      {% for panel in home.journeyPanels %}
      <a href="{{ panel.link }}" class="journey-panel">
        <img src="{{ panel.image }}" alt="{{ panel.imageAlt }}" width="700" height="800" loading="lazy">
        <div class="journey-panel-overlay">
          <h3>{{ panel.title }}</h3>
          <p>{{ panel.text }}</p>
          <span class="journey-panel-link">{{ panel.linkText }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
          </span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Most popular</span>
      <h2>Most Popular Tours</h2>
      <p class="lede">Explore our most popular battlefield experiences, from focused day tours to complete multi-day journeys across the Western Front and Normandy.</p>
    </div>

    <div class="tours-grid" data-reveal>
      {% for slug in home.popularTourSlugs %}{% for tour in tours %}{% if tour.slug == slug %}{{ tourCard(tour) }}{% endif %}{% endfor %}{% endfor %}
    </div>

    <div style="text-align: center; margin-top: var(--space-5);">
      <a href="/tours.html" class="btn btn-primary">View All Battlefield Tours</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="two-col-media reverse" data-reveal>
      <div class="two-col-media-media rounded-photo">
        <img src="{{ home.familyTeaserImage }}" alt="{{ home.familyTeaserAlt }}" width="1800" height="1200">
      </div>
      <div class="stack" style="gap: var(--space-3);">
        <span class="eyebrow">A tour like no other</span>
        <h2>Trace your family's footsteps.</h2>
        <p class="body-text">{{ home.familyTeaserParagraph }}</p>
        <p class="pull-quote" style="font-size: 1.15rem; margin-block: var(--space-2);">"{{ home.familyTeaserQuote }}"</p>
        <div>
          <a href="/family-research.html" class="btn btn-primary">How it works</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section--alt" id="testimonials">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow">Testimonials</span>
      <h2>Trusted by families, historians and veterans.</h2>
    </div>

    <div class="testimonial-grid testimonial-grid--3" data-reveal>
      {{ testimonialCard(testimonials[0]) }}
      {{ testimonialCard(testimonials[2]) }}
      {{ testimonialCard(testimonials[4]) }}
    </div>

    <div style="text-align: center; margin-top: var(--space-5);">
      <a href="/testimonials.html" class="btn btn-ghost">Read Guest Reviews</a>
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container">
    <div class="email-capture" data-reveal>
      <div class="stack" style="gap: var(--space-2); text-align: center; align-items: center;">
        <span class="eyebrow eyebrow--on-dark">Stay in touch</span>
        <h2 style="color: #FFF; max-width: 20ch;">{{ home.emailCaptureHeading }}</h2>
        <p class="lede" style="max-width: 50ch;">{{ home.emailCaptureText }}</p>
      </div>
      <form class="email-capture-form" id="emailCaptureForm" name="tour-list-signup" method="POST" data-netlify="true" netlify-honeypot="signupBotField" novalidate>
        <input type="hidden" name="form-name" value="tour-list-signup">
        <p class="visually-hidden">
          <label>Don't fill this out if you're human: <input name="signupBotField" tabindex="-1" autocomplete="off"></label>
        </p>
        <div class="form-grid form-grid--2">
          <div class="form-field">
            <label for="signupName" class="visually-hidden">First name</label>
            <input type="text" id="signupName" name="signupName" placeholder="First name" autocomplete="given-name">
          </div>
          <div class="form-field">
            <label for="signupEmail" class="visually-hidden">Email</label>
            <input type="email" id="signupEmail" name="signupEmail" placeholder="Email address" autocomplete="email" required>
          </div>
        </div>
        <div class="form-field">
          <label for="signupInterest">Area of interest</label>
          <select id="signupInterest" name="signupInterest">
            <option value="">Not sure yet</option>
            <option value="western-front">Western Front</option>
            <option value="normandy">Normandy</option>
            <option value="multi-day">Multi-day tours</option>
            <option value="family-research">Private family research</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Join the Tour List</button>
        <p class="form-status" id="signupStatus" role="status"></p>
      </form>
    </div>
  </div>
</section>
