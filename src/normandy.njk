{% from "partials/macros.njk" import tourCard %}

<header class="hero hero--compact">
  <div class="hero-media">
    <img src="/photos/juno-paris/juno-paris-cover.jpg" alt="Aerial view of Juno Beach, with the Canadian memorial and preserved bunker in the foreground" width="1800" height="1200">
  </div>
  <div class="container">
    <div class="hero-content">
      <span class="eyebrow">Normandy</span>
      <h1>Stand where the Allies landed.</h1>
      <p class="lede">From Juno Beach and Omaha Beach day tours to multi-day journeys across the full American, British and Canadian D-Day story, and on to Mont-Saint-Michel.</p>
    </div>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Day tours</span>
      <h2>Juno Beach and Omaha Beach, in a single unforgettable day.</h2>
    </div>

    <div class="tours-grid" data-reveal>
      {% for tour in tours %}{% if tour.normandyRegion and not tour.combo %}{{ tourCard(tour) }}{% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Multi-day tours</span>
      <h2>The complete Normandy experience.</h2>
      <p class="lede">Combine the American, British and Canadian D-Day sectors into one seamless journey, with accommodation recommendations in the historic towns of Bayeux and Caen.</p>
    </div>

    <div class="tours-grid" data-reveal>
      {% for tour in tours %}{% if tour.normandyRegion and tour.combo %}{{ tourCard(tour) }}{% endif %}{% endfor %}
    </div>

    <div class="info-panel" style="position: static; margin-top: var(--space-5); max-width: 760px;" data-reveal>
      <h3>Already visiting the Western Front?</h3>
      <p class="body-text">Our 5-Day Western Front &amp; Normandy tour combines the Canadian story from Vimy Ridge and Flanders Fields through to the Somme, then continues on to Juno Beach and the Normandy landing sites.</p>
      <a href="/tours/western-front-normandy-5day.html" class="btn btn-ghost btn-sm">View this tour</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-band" data-reveal>
      <h2>Not sure which tour is right for you?</h2>
      <p class="lede">Send us a message and we'll help you choose the best fit for your trip.</p>
      <a href="/contact.html" class="btn btn-primary btn-lg">Get In Touch</a>
    </div>
  </div>
</section>
